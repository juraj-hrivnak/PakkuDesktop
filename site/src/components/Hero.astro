---
import ExternalLink from './ExternalLink.astro';
import { desktopDownloadPath, installPakkuUrl, pakkuJarUrl } from '../lib/links';
---
<header class="flex min-h-[calc(100svh-var(--nav-h))] items-center px-[7vw] py-[8vh]">
  <div class="flex w-full flex-col items-start justify-between gap-8 md:flex-row md:items-end">
    <div class="min-w-0">
      <h1 class="ms-[-0.06em] text-[clamp(4rem,16vw,12rem)] font-extrabold leading-[0.9] tracking-[-0.04em]">
        Pakku
      </h1>
      <p class="tagline mt-5 max-w-[36ch] text-[clamp(1.1rem,0.55rem+1.6vw,1.85rem)] leading-normal">
        The package manager and build tool for Minecraft modpacks.
      </p>
    </div>
    <div class="relative z-[35] flex w-full max-w-xs flex-col gap-3 md:w-auto">
      <ExternalLink class="pakku-btn pakku-btn--primary" href={installPakkuUrl}>Install Pakku</ExternalLink>
      <ExternalLink class="pakku-btn" href={pakkuJarUrl}>Download pakku.jar</ExternalLink>
      <a class="pakku-btn" href={desktopDownloadPath}>Download Desktop</a>
    </div>
  </div>
</header>
