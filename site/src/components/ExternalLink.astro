---
interface Props {
  href: string;
  class?: string;
  [key: string]: unknown;
}

const { href, class: className, ...rest } = Astro.props;
---
<a href={href} class={className} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab" {...rest}>
  <slot /><svg class="ext" width="12" height="12" aria-hidden="true"><use href="#ext"/></svg>
</a>
