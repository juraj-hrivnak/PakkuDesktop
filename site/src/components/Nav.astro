---
const docsUrl = 'https://juraj-hrivnak.github.io/Pakku';
const discordUrl = 'https://discord.com/invite/dtAyqdzTMj';
const downloadUrl = 'https://github.com/juraj-hrivnak/Pakku/releases';
---
<nav aria-label="Primary">
  <div class="wrap nav-inner">
    <a class="brand" href="/">
      <svg width="24" height="24" viewBox="0 0 500 500" aria-hidden="true"><use href="#pakku-glyph"/></svg>
      Pakku
    </a>

    <details class="nav-mobile">
      <summary class="nav-mobile-btn">Menu</summary>
      <ul class="nav-mobile-list">
        <li><a href="#shots">Showcase</a></li>
        <li><a href={docsUrl} target="_blank" rel="noopener noreferrer">Documentation</a></li>
        <li><a href="https://github.com/juraj-hrivnak/Pakku" target="_blank" rel="noopener noreferrer">Pakku on GitHub</a></li>
        <li><a href="https://github.com/juraj-hrivnak/PakkuDesktop" target="_blank" rel="noopener noreferrer">Pakku Desktop on GitHub</a></li>
        <li><a href={discordUrl} target="_blank" rel="noopener noreferrer">Discord</a></li>
        <li><a href={downloadUrl} target="_blank" rel="noopener noreferrer">Download</a></li>
      </ul>
    </details>

    <ul class="nav-links">
      <li><a href="#shots">Showcase</a></li>
      <li><a href={docsUrl} target="_blank" rel="noopener noreferrer">Documentation</a></li>
      <li class="nav-drop">
        <button
          class="nav-drop-btn"
          type="button"
          id="githubMenuBtn"
          aria-expanded="false"
          aria-controls="githubMenu"
        >
          GitHub
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <ul class="nav-drop-menu" id="githubMenu" hidden>
          <li><a href="https://github.com/juraj-hrivnak/Pakku" target="_blank" rel="noopener noreferrer">Pakku</a></li>
          <li><a href="https://github.com/juraj-hrivnak/PakkuDesktop" target="_blank" rel="noopener noreferrer">Pakku Desktop</a></li>
        </ul>
      </li>
      <li><a href={discordUrl} target="_blank" rel="noopener noreferrer">Discord</a></li>
    </ul>

    <a class="btn btn-primary" href={downloadUrl} target="_blank" rel="noopener noreferrer">Download</a>
  </div>
</nav>

<script>
  const btn = document.getElementById('githubMenuBtn');
  const menu = document.getElementById('githubMenu');

  if (btn instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      menu.hidden = !open;
      btn.classList.toggle('is-open', open);
    };

    const close = () => setOpen(false);
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';

    const closeIfOutside = (target: EventTarget | null) => {
      if (!isOpen()) return;
      if (!(target instanceof Node)) return;
      if (btn.contains(target) || menu.contains(target)) return;
      close();
    };

    btn.addEventListener('click', () => {
      setOpen(!isOpen());
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!isOpen()) return;
      close();
      btn.focus();
    });

    document.addEventListener('click', (e) => closeIfOutside(e.target));
    document.addEventListener('focusin', (e) => closeIfOutside(e.target));
  }
</script>
