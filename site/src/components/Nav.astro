---
import ExternalLink from './ExternalLink.astro';
import {
  desktopDownloadPath,
  discordUrl,
  docsUrl,
  installPakkuUrl,
  pakkuDesktopGithub,
  pakkuGithub,
  pakkuJarUrl,
} from '../lib/links';

const path = Astro.url.pathname;
const isHome = path === '/' || path === '';
const isDownload =
  path === '/download' || path === '/download/' || path.startsWith('/download/');
---
<nav
  class="site-nav flex h-[var(--nav-h)] w-full items-center gap-3 border-b border-white/7 bg-black/72 px-[7vw] backdrop-blur-[10px]"
  aria-label="Primary"
>
  <div class="flex min-w-0 items-center gap-2">
    <div class="lg:hidden">
      <label for="pakku-drawer" aria-label="Open menu" class="btn btn-square btn-ghost drawer-button">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block size-5 stroke-current" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
    </div>
    <a class="brand inline-flex items-center gap-2 text-[0.95rem] font-semibold text-base-content no-underline hover:no-underline" href="/">
      <svg width="24" height="24" viewBox="0 0 500 500" aria-hidden="true"><use href="#pakku-glyph"/></svg>
      Pakku
    </a>
  </div>

  <div class="site-nav-end ms-auto flex min-w-0 items-center justify-end">
    <ul class="site-nav-links hidden items-center gap-5 text-[0.85rem] lg:flex">
      <li><ExternalLink href={docsUrl}>Documentation</ExternalLink></li>
      <li class="dropdown">
        <div tabindex="0" role="button" class="inline-flex cursor-pointer items-center gap-1.5">
          GitHub
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        <ul tabindex="-1" class="dropdown-content menu menu-sm rounded-box z-1 mt-2 w-44 bg-base-200 p-1.5 shadow">
          <li><ExternalLink href={pakkuGithub}>Pakku</ExternalLink></li>
          <li><ExternalLink href={pakkuDesktopGithub}>Pakku Desktop</ExternalLink></li>
        </ul>
      </li>
      <li><ExternalLink href={discordUrl}>Discord</ExternalLink></li>
    </ul>

    {!isDownload && (
      <div
        class:list={['nav-download-slot', { 'is-deferred': isHome }]}
        data-nav-download={isHome ? 'home' : undefined}
      >
        <div class="nav-download dropdown dropdown-end relative z-[35]">
          <div tabindex="0" role="button" class="pakku-btn pakku-btn--primary">Download</div>
          <ul tabindex="-1" class="menu menu-sm dropdown-content bg-base-200 rounded-box z-1 mt-2 w-56 p-1.5 shadow">
            <li><ExternalLink href={installPakkuUrl}>Install Pakku</ExternalLink></li>
            <li><ExternalLink href={pakkuJarUrl}>Download pakku.jar</ExternalLink></li>
            <li><a href={desktopDownloadPath}>Download Desktop</a></li>
          </ul>
        </div>
      </div>
    )}
  </div>
</nav>

{isHome && (
  <script>
    const slot = document.querySelector('[data-nav-download="home"]');
    const fold = document.getElementById('home-fold');
    const SLOT_PX = 180;
    const SPACE_END = 0.72;

    if (slot instanceof HTMLElement) {
      const button = slot.querySelector('.nav-download');

      const placeFold = () => {
        if (!(fold instanceof HTMLElement)) return;
        const main = document.getElementById('main');
        const mainTop =
          main instanceof HTMLElement
            ? main.getBoundingClientRect().top + window.scrollY
            : 0;
        // First-screen bottom in document space, relative to main.
        fold.style.top = `${Math.max(0, window.innerHeight - mainTop)}px`;
      };

      const clamp01 = (value: number) => Math.min(1, Math.max(0, value));

      const applyProgress = (progress: number) => {
        const p = clamp01(progress);
        // Links shift first; button fades only after the slot is open.
        const space = clamp01(p / SPACE_END);
        const fade = p <= SPACE_END ? 0 : clamp01((p - SPACE_END) / (1 - SPACE_END));

        slot.style.width = `${SLOT_PX * space}px`;
        slot.style.overflow = space >= 1 ? 'visible' : 'hidden';

        if (button instanceof HTMLElement) {
          button.style.opacity = String(fade);
          button.style.pointerEvents = fade > 0.85 ? 'auto' : 'none';
        }
      };

      const sync = () => {
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !(fold instanceof HTMLElement)) {
          applyProgress(1);
          return;
        }

        // 0 at the fold (bottom of first screen) → 1 when the fold hits the top.
        const top = fold.getBoundingClientRect().top;
        const range = Math.max(1, window.innerHeight);
        applyProgress(1 - top / range);
      };

      placeFold();
      sync();
      window.addEventListener('scroll', sync, { passive: true });
      window.addEventListener(
        'resize',
        () => {
          if (window.scrollY <= 0) placeFold();
          sync();
        },
        { passive: true },
      );
    }
  </script>
)}
