<button class="theme-btn" id="themeBtn" type="button" aria-pressed="false" aria-label="Toggle yellow background" title="Toggle yellow background"></button>

<script>
  const btn = document.getElementById('themeBtn');
  if (btn instanceof HTMLButtonElement) {
    btn.addEventListener('click', () => {
      const on = document.documentElement.classList.toggle('yellow');
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }
</script>
