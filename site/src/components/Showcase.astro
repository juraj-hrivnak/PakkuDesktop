---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  homeDark: ImageMetadata;
  overviewDark: ImageMetadata;
  filesFetchDark: ImageMetadata;
  gitLogDark: ImageMetadata;
  gitCommitDark: ImageMetadata;
  filesSyncDark: ImageMetadata;
  screenshotLs: ImageMetadata;
  screenshotExport: ImageMetadata;
}

const {
  homeDark,
  overviewDark,
  filesFetchDark,
  gitLogDark,
  gitCommitDark,
  filesSyncDark,
  screenshotLs,
  screenshotExport,
} = Astro.props;
---
<section class="shots" id="shots" aria-label="CLI and Desktop showcase">
  <div class="shots-stage">
    <figure class="shots-cli">
      <h2>CLI</h2>
      <div class="cli-row" id="cliRow">
        <Image src={screenshotLs} alt="pakku ls listing the modpack projects in a terminal" widths={[580, 780]} sizes="(max-width: 720px) 84vw, min(40vw, 580px)" loading="lazy" decoding="async" />
        <Image src={screenshotExport} alt="pakku export building the distribution packages in a terminal" widths={[580, 780]} sizes="(max-width: 720px) 84vw, min(40vw, 580px)" loading="lazy" decoding="async" />
      </div>
    </figure>
    <figure class="shots-desk">
      <h2>Desktop</h2>
      <div class="shots-row" id="shotsRow">
        <Image src={homeDark} alt="Pakku Desktop home screen" widths={[560, 840]} sizes="(max-width: 720px) 84vw, min(42vw, 560px)" loading="eager" decoding="async" fetchpriority="high" />
        <Image src={overviewDark} alt="Pakku Desktop modpack overview" widths={[560, 840]} sizes="(max-width: 720px) 84vw, min(42vw, 560px)" loading="lazy" decoding="async" />
        <Image src={filesFetchDark} alt="Pakku Desktop fetching projects" widths={[560, 840]} sizes="(max-width: 720px) 84vw, min(42vw, 560px)" loading="lazy" decoding="async" />
        <Image src={gitLogDark} alt="Pakku Desktop git history" widths={[560, 840]} sizes="(max-width: 720px) 84vw, min(42vw, 560px)" loading="lazy" decoding="async" />
        <Image src={gitCommitDark} alt="Pakku Desktop commit dialog" widths={[560, 840]} sizes="(max-width: 720px) 84vw, min(42vw, 560px)" loading="lazy" decoding="async" />
        <Image src={filesSyncDark} alt="Pakku Desktop syncing files" widths={[560, 840]} sizes="(max-width: 720px) 84vw, min(42vw, 560px)" loading="lazy" decoding="async" />
      </div>
    </figure>
  </div>
</section>
