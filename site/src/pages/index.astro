---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Slogan from '../components/Slogan.astro';
import Showcase from '../components/Showcase.astro';
import FinalCta from '../components/FinalCta.astro';

import screenshotLs from '../../images/screenshot_ls.png';
import screenshotExport from '../../images/screenshot_export.png';
import overview from '../../images/modpack-overview-dark-v1.0.0-alpha.11.png';
import filesFetch from '../../images/files-fetch-dark-v1.0.0-alpha.11.png';
import filesSync from '../../images/files-sync-dark-v1.0.0-alpha.11.png';
import gitLog from '../../images/git-log-dark-v1.0.0-alpha.11.png';
---
<BaseLayout>
  <main id="main" class="home-main">
    <Hero />
    <div class="home-fold" id="home-fold" aria-hidden="true"></div>
    <Slogan />
    <Showcase
      screenshotLs={screenshotLs}
      screenshotExport={screenshotExport}
      overview={overview}
      filesFetch={filesFetch}
      filesSync={filesSync}
      gitLog={gitLog}
    />
    <FinalCta />
  </main>
</BaseLayout>
